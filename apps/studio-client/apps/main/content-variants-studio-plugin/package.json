{
  "name": "@coremedia-labs/studio-client.ext.content-variants-studio-client.main",
  "author": "CoreMedia GmbH",
  "version": "1.0.0-SNAPSHOT",
  "license": "CoreMedia Open Source License",
  "private": true,
  "dependencies": {
    "@coremedia-blueprint/studio-client.main.blueprint-forms": "workspace:*",
    "@coremedia-labs/studio-client.ext.content-variants-studio-client": "workspace:*",
    "@coremedia/studio-client.cap-base-models": "catalog:",
    "@coremedia/studio-client.ext.cap-base-components": "catalog:",
    "@coremedia/studio-client.ext.content-link-list-components": "catalog:",
    "@coremedia/studio-client.ext.ui-components": "catalog:",
    "@coremedia/studio-client.main.editor-components": "catalog:",
    "@jangaroo/ext-ts": "catalog:",
    "@jangaroo/runtime": "catalog:"
  },
  "devDependencies": {
    "@jangaroo/build": "catalog:",

    "@jangaroo/core": "catalog:",
    "@coremedia/studio-client.ext.eslint-config": "catalog:",
    "eslint": "catalog:",

    "rimraf": "catalog:"
  },
  "scripts": {
    "clean": "rimraf ./dist && rimraf ./build",
    "build": "jangaroo build",
    "watch": "jangaroo watch",
    "lint": "eslint"
  },
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "coremedia": {
    "projectExtensionFor": "studio-client.main-static"
  },
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": false,
    "exports": {
      "./*": {
        "types": "./src/*.d.ts",
        "default": "./src/*.js"
      }
    }
  }
}
